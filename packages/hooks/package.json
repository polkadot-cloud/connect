{
	"name": "@polkadot-cloud/hooks",
	"description": "Shared React hooks and safe context helpers",
	"version": "0.1.3",
	"license": "GPL-3.0-only",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"keywords": ["polkadot", "react", "hooks", "context", "typescript"],
	"homepage": "https://github.com/polkadot-cloud/connect/tree/main/packages/hooks#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/polkadot-cloud/connect.git",
		"directory": "packages/hooks"
	},
	"bugs": {
		"url": "https://github.com/polkadot-cloud/connect/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clear": "rm -rf node_modules dist tsconfig.tsbuildinfo",
		"check": "biome check .",
		"lint": "biome check --write .",
		"build": "tsup",
		"compile": "builder -t hooks"
	},
	"devDependencies": {
		"@types/react": "^19",
		"builder": "workspace:*",
		"react": "^19",
		"tsup": "^8"
	},
	"peerDependencies": {
		"react": "^19.1.0"
	}
}
